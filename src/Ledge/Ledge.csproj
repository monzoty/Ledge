<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Required by [LibraryImport]: its generated P/Invoke code uses pointers.
         Only this project needs it; Ledge.Core stays free of unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PerMonitorV2 DPI awareness is declared here. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledge.Core\Ledge.Core.csproj" />
  </ItemGroup>

  <!-- Stand-in tray icon (DESIGN.md §0), compiled into the exe; loaded via a pack:// URI. -->
  <ItemGroup>
    <Resource Include="Resources\Ledge.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
