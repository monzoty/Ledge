<!--
  Design tokens: sizes, radii, spacing and fonts.
  Source of truth: docs/DESIGN.md §2–§3. Do not change values here without
  changing DESIGN.md first. Colours live in Colors.<Theme>.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Spacing (DESIGN.md §3): every margin/padding is a multiple of 4. -->
  <sys:Double x:Key="SpacingUnit">4</sys:Double>

  <!-- Pill (DESIGN.md §1–§2) -->
  <sys:Double x:Key="PillWidth">112</sys:Double>
  <sys:Double x:Key="PillTimerWidth">136</sys:Double>
  <sys:Double x:Key="PillHeight">28</sys:Double>
  <Thickness x:Key="PillTopOffset">0,4,0,0</Thickness>
  <CornerRadius x:Key="PillCornerRadius">14</CornerRadius>
  <sys:Double x:Key="PillHoverMargin">8</sys:Double>
  <!-- Gap between pill icon and label: one SpacingUnit -->
  <Thickness x:Key="PillIconGap">4,0,0,0</Thickness>
  <!-- "3 today" status dot (DESIGN.md §2): 6 DIP Accent circle, same 4 DIP gap -->
  <sys:Double x:Key="PillDotSize">6</sys:Double>
  <!-- "All clear" ↔ "n today" crossfade (DESIGN.md §4). Set to 0 by App when animations are off. -->
  <Duration x:Key="PillLabelDuration">0:0:0.150</Duration>

  <!--
    Hover zone (DESIGN.md §1). Derived: PillHoverMargin (8) on left, right and
    bottom; PillTopOffset (4) on top, so the zone touches the screen edge.
  -->
  <Thickness x:Key="HoverZonePadding">8,4,8,8</Thickness>

  <!-- Motion (DESIGN.md §4) -->
  <sys:TimeSpan x:Key="ExpandDuration">0:0:0.220</sys:TimeSpan>
  <sys:TimeSpan x:Key="CollapseDuration">0:0:0.160</sys:TimeSpan>
  <!-- Expand: content starts fading in this long after the size starts growing -->
  <sys:TimeSpan x:Key="ExpandContentFadeDelay">0:0:0.060</sys:TimeSpan>
  <!--
    Derived, not in DESIGN.md:
    - Collapse content fade-out mirrors the expand fade delay (60 ms).
    - Size changes are split evenly: expand = width then height (110 ms each);
      collapse = height then width over the remaining 100 ms (50 ms each).
  -->
  <sys:TimeSpan x:Key="CollapseContentFadeDuration">0:0:0.060</sys:TimeSpan>

  <!-- Hover timing (DESIGN.md §5) -->
  <sys:TimeSpan x:Key="HoverOpenDelay">0:0:0.150</sys:TimeSpan>
  <sys:TimeSpan x:Key="HoverCloseDelay">0:0:0.300</sys:TimeSpan>

  <!-- Panel (DESIGN.md §2–§3) -->
  <sys:Double x:Key="PanelWidth">360</sys:Double>
  <sys:Double x:Key="PanelMinHeight">160</sys:Double>
  <sys:Double x:Key="PanelMaxHeight">520</sys:Double>
  <CornerRadius x:Key="PanelCornerRadius">16</CornerRadius>
  <CornerRadius x:Key="RowCornerRadius">8</CornerRadius>
  <sys:Double x:Key="PanelShadowBlur">24</sys:Double>
  <sys:Double x:Key="PanelShadowOffsetY">8</sys:Double>
  <sys:Double x:Key="PanelShadowOpacity">0.35</sys:Double>
  <!-- Panel layout (DESIGN.md §2): padding 16, gaps 12 -->
  <Thickness x:Key="PanelPadding">16</Thickness>
  <sys:Double x:Key="QuickAddHeight">36</sys:Double>
  <sys:Double x:Key="TimerRowHeight">32</sys:Double>
  <sys:Double x:Key="TaskRowHeight">32</sys:Double>
  <!-- Quick-add inner spacing. Derived from SpacingUnit (not in DESIGN.md): 12 at the edges, 8 between icon and text -->
  <Thickness x:Key="QuickAddLeadingIconMargin">12,0,8,0</Thickness>
  <Thickness x:Key="QuickAddTrailingIconMargin">8,0,12,0</Thickness>

  <!--
    Task lists (DESIGN.md §2 "List details"): everything starts 12 in (under the
    quick-add "+"), 8 between checkbox and title; header 12 below the block
    above, rows 4 below the header. Right-hand 12 mirrors the left (derived).
  -->
  <Thickness x:Key="SectionHeaderMargin">12,12,12,4</Thickness>
  <Thickness x:Key="TaskRowCheckboxMargin">12,0,8,0</Thickness>
  <Thickness x:Key="TaskRowTitleMargin">0,0,12,0</Thickness>
  <Thickness x:Key="EmptyStateMargin">12,0,12,0</Thickness>
  <!-- Hover move icon: 12 from the row's right edge (DESIGN.md §2 "Move action") -->
  <Thickness x:Key="TaskRowActionMargin">0,0,12,0</Thickness>
  <!-- Hover trash icon: 8 to the left of the move icon (DESIGN.md §2 "Delete action") -->
  <Thickness x:Key="TaskRowDeleteMargin">0,0,8,0</Thickness>
  <!-- Keyboard focus ring (DESIGN.md §3): 2 DIP -->
  <Thickness x:Key="FocusRingThickness">2</Thickness>
  <!--
    Delete (DESIGN.md §4): row height and opacity → 0 in 120 ms, QuadraticEase EaseIn.
    Also read by App for the ViewModel, which waits for it before deleting.
  -->
  <Duration x:Key="TaskRemoveDuration">0:0:0.120</Duration>
  <!-- Inbox header chevron (DESIGN.md §2 "Inbox header"): 12 DIP, 4 DIP gap, turns 90° in 150 ms -->
  <sys:Double x:Key="ChevronIconSize">12</sys:Double>
  <Thickness x:Key="ChevronGap">0,0,4,0</Thickness>
  <sys:Double x:Key="ChevronExpandedAngle">90</sys:Double>
  <Duration x:Key="InboxChevronDuration">0:0:0.150</Duration>
  <!-- Done row (DESIGN.md §4): opacity 60 %, 150 ms QuadraticEase EaseOut -->
  <sys:Double x:Key="TaskDoneOpacity">0.6</sys:Double>
  <!--
    A Duration (not TimeSpan) because XAML Storyboards use it directly.
    App.OnStartup sets it to 0 when Windows "Animation effects" is off.
  -->
  <Duration x:Key="TaskDoneDuration">0:0:0.150</Duration>
  <!-- Panel grows/shrinks to fit new content while open (DESIGN.md §2) -->
  <sys:TimeSpan x:Key="PanelResizeDuration">0:0:0.150</sys:TimeSpan>

  <!-- Tray menu (DESIGN.md §5 "Tray icon"): 1 DIP outline, 4 DIP inner padding, items 32 high with 12 DIP sides -->
  <Thickness x:Key="MenuBorderThickness">1</Thickness>
  <Thickness x:Key="MenuPadding">4</Thickness>
  <Thickness x:Key="MenuItemPadding">12,0,12,0</Thickness>

  <!-- Timer row (DESIGN.md §2 "Timer row") -->
  <Thickness x:Key="TimerRowMargin">0,12,0,0</Thickness>
  <Thickness x:Key="TimerDividerMargin">0,12,0,0</Thickness>
  <sys:Double x:Key="DividerThickness">1</sys:Double>
  <sys:Double x:Key="ChipHeight">24</sys:Double>
  <Thickness x:Key="ChipPadding">8,0,8,0</Thickness>
  <Thickness x:Key="ChipGap">0,0,4,0</Thickness>
  <Thickness x:Key="ChipBorderThickness">1</Thickness>
  <!-- Between the play/pause and stop icons, and between the two replace buttons -->
  <Thickness x:Key="TimerButtonGap">0,0,8,0</Thickness>
  <!-- The replace question: its buttons sit 8 below the text -->
  <Thickness x:Key="TimerQuestionButtonsMargin">0,8,0,0</Thickness>
  <!-- The question uses the row's left/right insets (12) -->
  <Thickness x:Key="TimerQuestionMargin">12,0,12,0</Thickness>

  <!-- Settings window (DESIGN.md §5 "Settings window") -->
  <sys:Double x:Key="SettingsWindowWidth">400</sys:Double>
  <Thickness x:Key="SettingsPadding">24</Thickness>
  <!-- Label → its control: 8; between settings: 16 (derived from the spacing unit) -->
  <Thickness x:Key="SettingsLabelMargin">0,0,0,8</Thickness>
  <Thickness x:Key="SettingsSectionMargin">0,16,0,0</Thickness>
  <!-- A label that starts a new setting: 16 above, 8 to its control -->
  <Thickness x:Key="SettingsSectionLabelMargin">0,16,0,8</Thickness>
  <!-- Hint / problem text under the shortcut box: one spacing unit below it -->
  <Thickness x:Key="SettingsHintMargin">0,4,0,0</Thickness>
  <!-- Toggle switch: 40 × 20, fully rounded; 12 DIP thumb, 4 DIP inset -->
  <sys:Double x:Key="ToggleWidth">40</sys:Double>
  <sys:Double x:Key="ToggleHeight">20</sys:Double>
  <CornerRadius x:Key="ToggleCornerRadius">10</CornerRadius>
  <sys:Double x:Key="ToggleThumbSize">12</sys:Double>
  <Thickness x:Key="ToggleThumbInset">4,0,4,0</Thickness>
  <Thickness x:Key="ToggleBorderThickness">1</Thickness>
  <!-- Segmented control: segments 32 high, 12 DIP sides, 1 DIP Accent outline when selected -->
  <sys:Double x:Key="SegmentHeight">32</sys:Double>
  <Thickness x:Key="SegmentPadding">12,0,12,0</Thickness>
  <Thickness x:Key="SegmentBorderThickness">1</Thickness>

  <!-- Thin overlay scrollbar (DESIGN.md §2): 4 wide; radius = half the width (derived) -->
  <sys:Double x:Key="ScrollBarWidth">4</sys:Double>
  <CornerRadius x:Key="ScrollBarCornerRadius">2</CornerRadius>

  <!--
    Overlay window size (ADR-0003). Derived, not a design value:
      margin = PanelShadowBlur + PanelShadowOffsetY = 32
      width  = PanelWidth    + 2 × 32 = 424
      height = PanelMaxHeight + 2 × 32 = 584
  -->
  <sys:Double x:Key="OverlayWindowWidth">424</sys:Double>
  <sys:Double x:Key="OverlayWindowHeight">584</sys:Double>

  <!-- Typography (DESIGN.md §3) -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="PillTextSize">12</sys:Double>
  <sys:Double x:Key="BodyTextSize">14</sys:Double>
  <sys:Double x:Key="CaptionTextSize">12</sys:Double>
  <sys:Double x:Key="SmallTextSize">12</sys:Double>
  <sys:Double x:Key="PillIconSize">12</sys:Double>
  <sys:Double x:Key="PanelIconSize">16</sys:Double>

  <!-- Icon glyphs (Segoe Fluent Icons / MDL2 share these code points) -->
  <sys:String x:Key="GlyphCheckMark">&#xE73E;</sys:String>
  <sys:String x:Key="GlyphAdd">&#xE710;</sys:String>
  <sys:String x:Key="GlyphReturnKey">&#xE751;</sys:String>
  <!-- Square checkbox (DESIGN.md §2): outline, and filled square with the check cut out -->
  <sys:String x:Key="GlyphCheckboxOpen">&#xE739;</sys:String>
  <sys:String x:Key="GlyphCheckboxDone">&#xE73D;</sys:String>
  <!-- Move action (DESIGN.md §2): tray = to Inbox, calendar = to Today -->
  <sys:String x:Key="GlyphMoveToInbox">&#xE7B8;</sys:String>
  <sys:String x:Key="GlyphMoveToToday">&#xE787;</sys:String>
  <sys:String x:Key="GlyphDelete">&#xE74D;</sys:String>
  <!-- Focus timer (DESIGN.md §2 "Timer row") -->
  <sys:String x:Key="GlyphStopwatch">&#xE916;</sys:String>
  <sys:String x:Key="GlyphPlay">&#xE768;</sys:String>
  <sys:String x:Key="GlyphPause">&#xE769;</sys:String>
  <sys:String x:Key="GlyphStop">&#xE71A;</sys:String>
  <!-- Points right (▸); rotated 90° when the Inbox is open (▾) -->
  <sys:String x:Key="GlyphChevron">&#xE76C;</sys:String>

  <!--
    Near-transparent hit area (ARCHITECTURE.md §6). Alpha 1/255 is invisible but,
    unlike alpha 0, still receives the mouse — so the hover margin works.
  -->
  <SolidColorBrush x:Key="HoverHitBrush" Color="#01000000" />

</ResourceDictionary>
