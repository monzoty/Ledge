<!--
  Settings-window controls, styled from tokens (DESIGN.md §5 "Settings window").
  Each Style replaces the control's whole look (Template) but keeps its
  behaviour: a CheckBox still toggles, RadioButtons in a group still exclude
  each other, and both work with the keyboard (Space, Tab, arrows).
  https://learn.microsoft.com/dotnet/desktop/wpf/controls/how-to-create-apply-template
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Keyboard focus ring (DESIGN.md §3: 2 DIP, FocusRing colour). WPF shows a
    FocusVisualStyle only when focus came from the KEYBOARD, never after a
    mouse click, which is exactly the rule we want.
    https://learn.microsoft.com/dotnet/desktop/wpf/advanced/styling-for-focus-in-controls-and-focusvisualstyle
  -->
  <Style x:Key="FocusRingVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource FocusRingBrush}"
                  BorderThickness="{StaticResource FocusRingThickness}"
                  CornerRadius="{StaticResource RowCornerRadius}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings labels: Body, TextPrimary -->
  <Style x:Key="SettingsLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodyTextSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Hint and problem text: Small -->
  <Style x:Key="SettingsHint" TargetType="TextBlock">
    <Setter Property="Margin" Value="{StaticResource SettingsHintMargin}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource SmallTextSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--
    Toggle switch: a CheckBox drawn as a 40 × 20 track with a 12 DIP thumb.
    Off: Surface track, Border outline, TextSecondary thumb on the left.
    On: Accent track, Background-coloured thumb on the right. Instant.
  -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track"
                  Width="{StaticResource ToggleWidth}"
                  Height="{StaticResource ToggleHeight}"
                  CornerRadius="{StaticResource ToggleCornerRadius}"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="{StaticResource ToggleBorderThickness}">
            <Ellipse x:Name="Thumb"
                     Width="{StaticResource ToggleThumbSize}"
                     Height="{StaticResource ToggleThumbSize}"
                     Margin="{StaticResource ToggleThumbInset}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BackgroundBrush}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    One segment of the segmented control: a RadioButton. The selected one gets
    a 1 DIP Accent outline and TextPrimary; the others TextSecondary.
  -->
  <Style x:Key="SegmentButton" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Segment"
                  Height="{StaticResource SegmentHeight}"
                  Padding="{StaticResource SegmentPadding}"
                  CornerRadius="{StaticResource RowCornerRadius}"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="{StaticResource SegmentBorderThickness}">
            <TextBlock x:Name="Label"
                       Text="{TemplateBinding Content}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="{StaticResource BodyTextSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Icon button (timer play / pause / stop): just the 16 DIP glyph, keyboard
    focusable (Tab), with the focus ring for keyboard users.
  -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The glyph inside an IconButton: 16 DIP, TextSecondary (DESIGN.md §2 "Timer row") -->
  <Style x:Key="IconGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource PanelIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    Preset chip (15 / 25 / 50): a RadioButton, so exactly one is selected.
    24 high, 8 DIP sides, Surface background, 8 DIP corners; the selected one
    has the 1 DIP Accent outline and TextPrimary (like the theme picker).
  -->
  <Style x:Key="ChipRadio" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chip"
                  Height="{StaticResource ChipHeight}"
                  Padding="{StaticResource ChipPadding}"
                  CornerRadius="{StaticResource RowCornerRadius}"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="Transparent"
                  BorderThickness="{StaticResource ChipBorderThickness}">
            <TextBlock x:Name="Label"
                       Text="{TemplateBinding Content}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="{StaticResource BodyTextSize}"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A button that looks like a chip ("Keep current"). -->
  <Style x:Key="ChipButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Height="{StaticResource ChipHeight}"
                  Padding="{StaticResource ChipPadding}"
                  CornerRadius="{StaticResource RowCornerRadius}"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{StaticResource ChipBorderThickness}">
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="{StaticResource BodyTextSize}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The main choice ("Start new"): a chip with the Accent outline. -->
  <Style x:Key="PrimaryChipButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

</ResourceDictionary>
