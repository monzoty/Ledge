<!--
  The tray icon's right-click menu, styled like the panel (DESIGN.md §5 "Tray icon").
  OverridesDefaultStyle="True" throws away WPF's built-in (Windows 7-looking)
  template completely, so only what we define here is drawn.
  https://learn.microsoft.com/dotnet/desktop/wpf/controls/menu-styles-and-templates
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="TrayMenu" TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource BackgroundBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="{StaticResource MenuBorderThickness}"
                  CornerRadius="{StaticResource RowCornerRadius}"
                  Padding="{StaticResource MenuPadding}">
            <!-- IsItemsHost: the menu items are placed in this panel. -->
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrayMenuItem" TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Background"
                  Height="{StaticResource TaskRowHeight}"
                  Padding="{StaticResource MenuItemPadding}"
                  CornerRadius="{StaticResource RowCornerRadius}"
                  Background="Transparent">
            <!-- ContentSource="Header": show the item's Header (its text). -->
            <ContentPresenter ContentSource="Header"
                              VerticalAlignment="Center"
                              TextElement.FontFamily="{StaticResource UiFont}"
                              TextElement.FontSize="{StaticResource BodyTextSize}"
                              TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- IsHighlighted: under the mouse, or selected with the arrow keys. -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource SurfaceBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
