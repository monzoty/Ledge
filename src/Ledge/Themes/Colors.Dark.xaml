<!--
  Colour tokens, dark theme. Source of truth: docs/DESIGN.md §3.
  Colors.Light.xaml has the same keys; ThemeService swaps one for the other.
  Panel colours are used with {DynamicResource …} so they follow the swap;
  pill colours are the same in both files.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Pill: identical in both themes -->
  <SolidColorBrush x:Key="PillBackgroundBrush" Color="#121214" />
  <SolidColorBrush x:Key="PillTextBrush" Color="#F2F2F5" />
  <!-- The "3 today" dot: always the dark-theme amber, because the pill is always dark (DESIGN.md §3) -->
  <SolidColorBrush x:Key="PillAccentBrush" Color="#F5A524" />
  <!-- Dimmed pill text (paused timer); the dark-theme grey in both themes -->
  <SolidColorBrush x:Key="PillTextSecondaryBrush" Color="#A0A0AB" />

  <!-- Panel -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="#1B1B1F" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#26262C" />
  <SolidColorBrush x:Key="BorderBrush" Color="#33333B" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F5" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0AB" />
  <SolidColorBrush x:Key="AccentBrush" Color="#F5A524" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="#F5A524" />

  <!-- Panel shadow: black; opacity is in Tokens.xaml (PanelShadowOpacity) -->
  <Color x:Key="PanelShadowColor">#000000</Color>

</ResourceDictionary>
