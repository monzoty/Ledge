<!--
  Colour tokens, light theme. Source of truth: docs/DESIGN.md §3.
  Same keys as Colors.Dark.xaml; ThemeService swaps one for the other.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Pill: identical in both themes (it's always dark) -->
  <SolidColorBrush x:Key="PillBackgroundBrush" Color="#121214" />
  <SolidColorBrush x:Key="PillTextBrush" Color="#F2F2F5" />
  <SolidColorBrush x:Key="PillAccentBrush" Color="#F5A524" />

  <!-- Panel -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="#F7F7F4" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#E4E4DF" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1E" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C66" />
  <!-- Darker amber than dark mode, so text in it meets WCAG AA on the light background -->
  <SolidColorBrush x:Key="AccentBrush" Color="#B45309" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
  <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="#B45309" />

  <!-- Panel shadow: black; opacity is in Tokens.xaml (PanelShadowOpacity) -->
  <Color x:Key="PanelShadowColor">#000000</Color>

</ResourceDictionary>
