<!--
  Thin overlay scrollbar (DESIGN.md §2 "List details"): 4 DIP, Border colour,
  rounded ends, visible only while the mouse is over the list.

  A ControlTemplate replaces a control's whole look while keeping its behaviour.
  The parts named PART_… are the ones the control's code looks for.
  https://learn.microsoft.com/dotnet/desktop/wpf/controls/how-to-create-apply-template
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The thumb: the part you drag. Just a rounded bar. -->
  <Style x:Key="ThinScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{StaticResource BorderBrush}"
                  CornerRadius="{StaticResource ScrollBarCornerRadius}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The bar: only a Track with a Thumb (no arrow buttons, no visible groove). -->
  <ControlTemplate x:Key="ThinVerticalScrollBar" TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.Thumb>
        <Thumb Style="{StaticResource ThinScrollThumb}" />
      </Track.Thumb>
    </Track>
  </ControlTemplate>

  <!--
    The ScrollViewer: content fills everything and the bar floats ON TOP of it at
    the right edge (an "overlay"), so rows don't shift when the bar appears.
  -->
  <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="Transparent">
            <ScrollContentPresenter />
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       HorizontalAlignment="Right"
                       Width="{StaticResource ScrollBarWidth}"
                       MinWidth="{StaticResource ScrollBarWidth}"
                       Template="{StaticResource ThinVerticalScrollBar}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{TemplateBinding VerticalOffset}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Only while the mouse is over the list. Instant: DESIGN.md has no motion for it. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
