<!--
  The overlay window (ADR-0003): one fixed-size, transparent, topmost window.
  Everything outside the hover zone is fully transparent, so clicks pass
  through to the app underneath.
-->
<Window x:Class="Ledge.Windows.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ledge.Views"
        Title="{StaticResource AppName}"
        Width="{StaticResource OverlayWindowWidth}"
        Height="{StaticResource OverlayWindowHeight}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

  <!--
    Hover zone (DESIGN.md §1): the shell plus an invisible margin.
    It touches the top screen edge, so pushing the mouse up there opens it.
    MouseEnter/MouseLeave on this one element drive open/close.
  -->
  <Border x:Name="HoverZone"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Padding="{StaticResource HoverZonePadding}"
          Background="{StaticResource HoverHitBrush}"
          MouseEnter="OnHoverZoneMouseEnter"
          MouseLeave="OnHoverZoneMouseLeave">

    <!--
      The shell is ONE shape that morphs between pill and panel (DESIGN.md §4).
      Width, Height, background colour and shadow are animated in
      PillWindow.Animation.cs; these are the collapsed starting values.
      Background is set in code (an animatable, non-shared brush).
    -->
    <Border x:Name="Shell"
            Width="{StaticResource PillWidth}"
            Height="{StaticResource PillHeight}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            CornerRadius="{StaticResource PillCornerRadius}"
            MouseLeftButtonDown="OnPillMouseLeftButtonDown"
            PreviewMouseLeftButtonDown="OnPanelPreviewMouseLeftButtonDown">
      <Border.Effect>
        <DropShadowEffect x:Name="ShellShadow"
                          BlurRadius="{StaticResource PanelShadowBlur}"
                          ShadowDepth="{StaticResource PanelShadowOffsetY}"
                          Direction="270"
                          Color="{StaticResource PanelShadowColor}"
                          Opacity="0" />
      </Border.Effect>

      <!-- Clips the content while the shell is smaller than it (mid-animation). -->
      <Grid ClipToBounds="True">

        <!-- Pill content, "All clear" state (DESIGN.md §2) -->
        <StackPanel x:Name="PillContent"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="{StaticResource GlyphCheckMark}"
                     FontFamily="{StaticResource IconFont}"
                     FontSize="{StaticResource PillIconSize}"
                     Foreground="{StaticResource PillTextBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{StaticResource PillAllClear}"
                     Margin="{StaticResource PillIconGap}"
                     FontFamily="{StaticResource UiFont}"
                     FontSize="{StaticResource PillTextSize}"
                     FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular"
                     Foreground="{StaticResource PillTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!--
          Panel content (DESIGN.md §2). Always laid out at full panel width so
          nothing reflows while the shell grows; the Grid clips it meanwhile.
          Quick-add stays at the top; everything below it scrolls once the
          panel reaches its max height. DataContext: TaskListViewModel (code-behind).
        -->
        <Border x:Name="PanelContent"
                Width="{StaticResource PanelWidth}"
                Padding="{StaticResource PanelPadding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed">
          <DockPanel>
            <views:QuickAddBox x:Name="QuickAdd" DockPanel.Dock="Top" />
            <ScrollViewer Style="{StaticResource ThinScrollViewer}" Focusable="False">
              <!--
                Inside a ScrollViewer, content gets unlimited height, so its
                SizeChanged tells us the list's natural height (used to resize the panel).
              -->
              <StackPanel x:Name="ListContent" SizeChanged="OnListContentSizeChanged">
                <views:TodaySection />
                <views:InboxSection />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>
    </Border>
  </Border>
</Window>
