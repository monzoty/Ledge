<!--
  The overlay window (ADR-0003): one fixed-size, transparent, topmost window.
  Everything outside the hover zone is fully transparent, so clicks pass
  through to the app underneath.
-->
<Window x:Class="Ledge.Windows.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ledge.Views"
        Title="{StaticResource AppName}"
        Width="{StaticResource OverlayWindowWidth}"
        Height="{StaticResource OverlayWindowHeight}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

  <!--
    Hover zone (DESIGN.md §1): the shell plus an invisible margin.
    It touches the top screen edge, so pushing the mouse up there opens it.
    MouseEnter/MouseLeave on this one element drive open/close.
  -->
  <Border x:Name="HoverZone"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Padding="{StaticResource HoverZonePadding}"
          Background="{StaticResource HoverHitBrush}"
          MouseEnter="OnHoverZoneMouseEnter"
          MouseLeave="OnHoverZoneMouseLeave">

    <!--
      The shell is ONE shape that morphs between pill and panel (DESIGN.md §4).
      Width, Height, background colour and shadow are animated in
      PillWindow.Animation.cs; these are the collapsed starting values.
      Background is set in code (an animatable, non-shared brush).
    -->
    <Border x:Name="Shell"
            Width="{StaticResource PillWidth}"
            Height="{StaticResource PillHeight}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            CornerRadius="{StaticResource PillCornerRadius}"
            MouseLeftButtonDown="OnPillMouseLeftButtonDown"
            PreviewMouseLeftButtonDown="OnPanelPreviewMouseLeftButtonDown">
      <Border.Effect>
        <DropShadowEffect x:Name="ShellShadow"
                          BlurRadius="{StaticResource PanelShadowBlur}"
                          ShadowDepth="{StaticResource PanelShadowOffsetY}"
                          Direction="270"
                          Color="{StaticResource PanelShadowColor}"
                          Opacity="0" />
      </Border.Effect>

      <!-- Clips the content while the shell is smaller than it (mid-animation). -->
      <Grid ClipToBounds="True">

        <!--
          Pill content (DESIGN.md §2): "✓ All clear" or "• 3 today". Both labels
          are stacked in one cell and cross-fade (DESIGN.md §4, 150 ms) when
          HasOpenToday flips; a changing number (3 → 2) just updates the text.
          The whole Grid fades out when the panel opens (PillWindow.Animation.cs).
          DataContext: TaskListViewModel (code-behind).
        -->
        <Grid x:Name="PillContent" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid.Resources>
            <Style x:Key="PillLabel" TargetType="TextBlock">
              <Setter Property="Margin" Value="{StaticResource PillIconGap}" />
              <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
              <Setter Property="FontSize" Value="{StaticResource PillTextSize}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
              <Setter Property="Foreground" Value="{StaticResource PillTextBrush}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </Grid.Resources>

          <!-- "All clear": visible unless there are open tasks. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasOpenToday}" Value="True">
                    <DataTrigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                           Duration="{StaticResource PillLabelDuration}"
                                           EasingFunction="{StaticResource QuadraticEaseOut}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                           Duration="{StaticResource PillLabelDuration}"
                                           EasingFunction="{StaticResource QuadraticEaseOut}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="{StaticResource GlyphCheckMark}"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="{StaticResource PillIconSize}"
                       Foreground="{StaticResource PillTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{StaticResource PillAllClear}" Style="{StaticResource PillLabel}" />
          </StackPanel>

          <!-- "• 3 today": starts hidden, fades in while there are open tasks. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasOpenToday}" Value="True">
                    <DataTrigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                           Duration="{StaticResource PillLabelDuration}"
                                           EasingFunction="{StaticResource QuadraticEaseOut}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                           Duration="{StaticResource PillLabelDuration}"
                                           EasingFunction="{StaticResource QuadraticEaseOut}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Ellipse Width="{StaticResource PillDotSize}"
                     Height="{StaticResource PillDotSize}"
                     Fill="{StaticResource PillAccentBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding TodayOpenCount, StringFormat={StaticResource PillTodayFormat}}"
                       Style="{StaticResource PillLabel}" />
          </StackPanel>
        </Grid>

        <!--
          Panel content (DESIGN.md §2). Always laid out at full panel width so
          nothing reflows while the shell grows; the Grid clips it meanwhile.
          Quick-add stays at the top; everything below it scrolls once the
          panel reaches its max height. DataContext: TaskListViewModel (code-behind).
        -->
        <Border x:Name="PanelContent"
                Width="{StaticResource PanelWidth}"
                Padding="{StaticResource PanelPadding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed"
                PreviewKeyDown="OnPanelPreviewKeyDown"
                PreviewTextInput="OnPanelPreviewTextInput">
          <!-- Ctrl+Z anywhere in the panel; a text box handles its own Ctrl+Z first. -->
          <Border.InputBindings>
            <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoDeleteCommand}" />
          </Border.InputBindings>
          <DockPanel>
            <views:QuickAddBox x:Name="QuickAdd" DockPanel.Dock="Top" />

            <!-- Focus timer row and the 1 DIP divider under it (DESIGN.md §2 "Timer row").
                 DataContext: TimerViewModel (code-behind). -->
            <views:TimerRow x:Name="TimerRow" DockPanel.Dock="Top" Margin="{StaticResource TimerRowMargin}" />
            <Border DockPanel.Dock="Top"
                    Height="{StaticResource DividerThickness}"
                    Margin="{StaticResource TimerDividerMargin}"
                    Background="{DynamicResource BorderBrush}" />
            <!--
              Undo hint (DESIGN.md §2): bottom of the panel, below the lists, one
              row high. Docked outside the ScrollViewer so it's always in view.
            -->
            <!--
              Data notice (DESIGN.md §2, §6): Small, Danger, wraps; at least one
              row high. Shown once, until the panel first closes. Only one of the
              two texts is ever visible.
            -->
            <Border x:Name="DataNotice"
                    DockPanel.Dock="Bottom"
                    MinHeight="{StaticResource TaskRowHeight}"
                    Visibility="{Binding ShowDataNotice, Converter={StaticResource BoolToVisibility}}">
              <Grid VerticalAlignment="Center">
                <TextBlock Text="{StaticResource DataRestoredNotice}"
                           Style="{StaticResource EmptyStateText}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowRestoredNotice, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{StaticResource DataResetNotice}"
                           Style="{StaticResource EmptyStateText}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowResetNotice, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
            <Border x:Name="UndoHint"
                    DockPanel.Dock="Bottom"
                    Height="{StaticResource TaskRowHeight}"
                    Visibility="{Binding ShowUndoHint, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{StaticResource UndoDeleteHint}" Style="{StaticResource EmptyStateText}" />
            </Border>
            <ScrollViewer Style="{StaticResource ThinScrollViewer}" Focusable="False">
              <!--
                Inside a ScrollViewer, content gets unlimited height, so its
                SizeChanged tells us the list's natural height (used to resize the panel).
              -->
              <StackPanel x:Name="ListContent" SizeChanged="OnListContentSizeChanged">
                <views:TodaySection />
                <views:InboxSection />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>
    </Border>
  </Border>
</Window>
