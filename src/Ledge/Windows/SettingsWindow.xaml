<!--
  Settings (PRD F6, DESIGN.md §5 "Settings window"): a standard window with a
  dark title bar, 400 wide, height fits content. Every change applies at once.
  DataContext: SettingsViewModel (code-behind).
-->
<Window x:Class="Ledge.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Ledge.Converters"
        xmlns:core="clr-namespace:Ledge.Core.Models;assembly=Ledge.Core"
        xmlns:vm="clr-namespace:Ledge.ViewModels"
        Title="{StaticResource SettingsTitle}"
        Icon="/Resources/Ledge.ico"
        Width="{StaticResource SettingsWindowWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True">

  <Window.Resources>
    <converters:EqualsToBoolConverter x:Key="EqualsToBool" />
  </Window.Resources>

  <StackPanel Margin="{StaticResource SettingsPadding}">

    <!-- ===== Shortcut ===== -->
    <TextBlock Text="{StaticResource SettingsShortcut}"
               Style="{StaticResource SettingsLabel}"
               Margin="{StaticResource SettingsLabelMargin}" />

    <Grid>
      <!--
        The shortcut box. Focusable so it receives the keys; clicking it starts
        recording, and code-behind passes each key to the ViewModel.
      -->
      <Border x:Name="ShortcutBox"
              Height="{StaticResource QuickAddHeight}"
              Padding="{StaticResource MenuItemPadding}"
              CornerRadius="{StaticResource RowCornerRadius}"
              Background="{DynamicResource SurfaceBrush}"
              Focusable="True"
              FocusVisualStyle="{StaticResource FocusRingVisual}"
              AutomationProperties.Name="{StaticResource SettingsShortcut}"
              MouseLeftButtonDown="OnShortcutBoxMouseDown"
              PreviewKeyDown="OnShortcutBoxPreviewKeyDown"
              LostKeyboardFocus="OnShortcutBoxLostFocus">
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsLabel}">
              <Setter Property="Text" Value="{Binding ShortcutText}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                  <Setter Property="Text" Value="{StaticResource SettingsShortcutRecording}" />
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>

      <!-- While recording: the 2 DIP FocusRing, drawn on top so nothing moves. -->
      <Border CornerRadius="{StaticResource RowCornerRadius}"
              BorderBrush="{DynamicResource FocusRingBrush}"
              BorderThickness="{StaticResource FocusRingThickness}"
              IsHitTestVisible="False"
              Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Under the box: the hint, or the problem in Danger (one at a time). -->
    <Grid>
      <TextBlock Text="{StaticResource SettingsShortcutHint}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShortcutProblem}" Value="{x:Static vm:ShortcutProblem.Invalid}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Binding="{Binding ShortcutProblem}" Value="{x:Static vm:ShortcutProblem.Taken}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <TextBlock Text="{StaticResource SettingsShortcutInvalid}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShortcutProblem}" Value="{x:Static vm:ShortcutProblem.Invalid}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <TextBlock Text="{Binding TakenShortcutText, StringFormat={StaticResource SettingsShortcutTaken}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShortcutProblem}" Value="{x:Static vm:ShortcutProblem.Taken}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- ===== Start with Windows: label left, switch right ===== -->
    <DockPanel Margin="{StaticResource SettingsSectionMargin}">
      <CheckBox DockPanel.Dock="Right"
                Style="{StaticResource ToggleSwitch}"
                IsChecked="{Binding StartWithWindows}"
                AutomationProperties.Name="{StaticResource SettingsStartWithWindows}" />
      <TextBlock Text="{StaticResource SettingsStartWithWindows}" Style="{StaticResource SettingsLabel}" />
    </DockPanel>

    <!-- ===== Theme: segmented control ===== -->
    <TextBlock Text="{StaticResource SettingsTheme}"
               Style="{StaticResource SettingsLabel}"
               Margin="{StaticResource SettingsSectionLabelMargin}" />
    <Border CornerRadius="{StaticResource RowCornerRadius}"
            Background="{DynamicResource SurfaceBrush}">
      <!-- UniformGrid: three equal-width segments across the full width. -->
      <UniformGrid Rows="1">
        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme"
                     Content="{StaticResource ThemeSystem}"
                     IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static core:ThemeMode.System}}" />
        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme"
                     Content="{StaticResource ThemeLight}"
                     IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static core:ThemeMode.Light}}" />
        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme"
                     Content="{StaticResource ThemeDark}"
                     IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static core:ThemeMode.Dark}}" />
      </UniformGrid>
    </Border>
  </StackPanel>
</Window>
