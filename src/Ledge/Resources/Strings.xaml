<!--
  All user-visible text in one place (PRD §5: English only, strings kept together).
  Source of truth: docs/DESIGN.md §6.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:String x:Key="AppName">Ledge</sys:String>
  <sys:String x:Key="PillAllClear">All clear</sys:String>
  <sys:String x:Key="QuickAddPlaceholder">Add a task…</sys:String>
  <!-- Section headers: shown UPPERCASE by the Caption style, e.g. "TODAY · 2" (DESIGN.md §2) -->
  <sys:String x:Key="SectionToday">Today</sys:String>
  <!-- xml:space="preserve": XAML trims leading/trailing spaces from text otherwise ("TODAY·2"). -->
  <sys:String x:Key="SectionCountSeparator" xml:space="preserve"> · </sys:String>
  <sys:String x:Key="TodayEmpty">Nothing on the ledge. Add a task above.</sys:String>
  <sys:String x:Key="SectionInbox">Inbox</sys:String>
  <sys:String x:Key="InboxEmpty">Inbox is clear.</sys:String>
  <sys:String x:Key="MoveToInbox">Move to Inbox</sys:String>
  <sys:String x:Key="MoveToToday">Move to Today</sys:String>
  <!-- {0} = the shortcut, e.g. "Win+Alt+L" -->
  <sys:String x:Key="HotkeyTakenMessage">{0} is already used by another app. Pick a different shortcut in Settings.</sys:String>

</ResourceDictionary>
