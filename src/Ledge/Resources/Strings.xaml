<!--
  All user-visible text in one place (PRD §5: English only, strings kept together).
  Source of truth: docs/DESIGN.md §6.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:String x:Key="AppName">Ledge</sys:String>
  <sys:String x:Key="PillAllClear">All clear</sys:String>
  <!-- {0} = number of open tasks in Today -->
  <sys:String x:Key="PillTodayFormat">{0} today</sys:String>
  <sys:String x:Key="QuickAddPlaceholder">Add a task…</sys:String>
  <!-- Section headers: shown UPPERCASE by the Caption style, e.g. "TODAY · 2" (DESIGN.md §2) -->
  <sys:String x:Key="SectionToday">Today</sys:String>
  <!-- xml:space="preserve": XAML trims leading/trailing spaces from text otherwise ("TODAY·2"). -->
  <sys:String x:Key="SectionCountSeparator" xml:space="preserve"> · </sys:String>
  <sys:String x:Key="TodayEmpty">Nothing on the ledge. Add a task above.</sys:String>
  <sys:String x:Key="SectionInbox">Inbox</sys:String>
  <sys:String x:Key="InboxEmpty">Inbox is clear.</sys:String>
  <sys:String x:Key="MoveToInbox">Move to Inbox</sys:String>
  <sys:String x:Key="MoveToToday">Move to Today</sys:String>
  <sys:String x:Key="DeleteTask">Delete</sys:String>
  <sys:String x:Key="UndoDeleteHint">Task deleted · Ctrl+Z to undo</sys:String>
  <!-- Tray menu (DESIGN.md §6); the tooltip is AppName -->
  <sys:String x:Key="TrayOpen">Open</sys:String>
  <sys:String x:Key="TraySettings">Settings</sys:String>
  <sys:String x:Key="TrayQuit">Quit</sys:String>
  <!-- Settings window (DESIGN.md §6) -->
  <sys:String x:Key="SettingsTitle">Ledge settings</sys:String>
  <sys:String x:Key="SettingsShortcut">Shortcut</sys:String>
  <sys:String x:Key="SettingsShortcutHint">Opens Ledge from anywhere. Click, then press the keys.</sys:String>
  <sys:String x:Key="SettingsShortcutRecording">Press a shortcut…</sys:String>
  <sys:String x:Key="SettingsShortcutInvalid">Use Win or Ctrl+Alt together with a key.</sys:String>
  <!-- {0} = the shortcut, e.g. "Win + Shift + K" -->
  <sys:String x:Key="SettingsShortcutTaken">{0} is already used by another app.</sys:String>
  <sys:String x:Key="SettingsStartWithWindows">Start with Windows</sys:String>
  <sys:String x:Key="SettingsTheme">Theme</sys:String>
  <sys:String x:Key="ThemeSystem">System</sys:String>
  <sys:String x:Key="ThemeLight">Light</sys:String>
  <sys:String x:Key="ThemeDark">Dark</sys:String>
  <!-- Data notices (DESIGN.md §6) -->
  <sys:String x:Key="DataRestoredNotice">Your task file couldn't be read, so Ledge restored the last backup.</sys:String>
  <sys:String x:Key="DataResetNotice">Your task file and its backup couldn't be read, so Ledge started with an empty list. The damaged files were kept in the Ledge data folder.</sys:String>
  <!-- {0} = the shortcut, e.g. "Win+Alt+L" -->
  <sys:String x:Key="HotkeyTakenMessage">{0} is already used by another app. Pick a different shortcut in Settings.</sys:String>

</ResourceDictionary>
