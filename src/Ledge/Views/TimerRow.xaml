<!--
  The focus timer row (DESIGN.md §2 "Timer row"), between quick-add and the
  lists. DataContext: TimerViewModel (set by PillWindow).
    Idle:    ⏱ Focus  [15] [25] [50]            ▶
    Running: ⏱ 18:42                          ❚❚  ■
    Paused:  ⏱ 18:42 (grey)                    ▶  ■
  or, while asking to replace a running session, the question and two buttons.
-->
<UserControl x:Class="Ledge.Views.TimerRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:Ledge.Converters">

  <UserControl.Resources>
    <converters:EqualsToBoolConverter x:Key="EqualsToBool" />
    <!-- Real numbers, so they compare equal to the int SelectedMinutes (PRD F4 presets). -->
    <sys:Int32 x:Key="Preset15">15</sys:Int32>
    <sys:Int32 x:Key="Preset25">25</sys:Int32>
    <sys:Int32 x:Key="Preset50">50</sys:Int32>

    <!-- Shown only in one timer state: a Style with one trigger per state. -->
    <Style x:Key="WhenIdle" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsIdle}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WhenNotIdle" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsIdle}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- ===== The normal row ===== -->
    <Grid Height="{StaticResource TimerRowHeight}">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsAskingToReplace}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{StaticResource GlyphStopwatch}"
                 Style="{StaticResource IconGlyph}"
                 Margin="{StaticResource TaskRowCheckboxMargin}" />

      <!-- Idle: "Focus" and the preset chips -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Style="{StaticResource WhenIdle}">
        <TextBlock Text="{StaticResource TimerFocus}"
                   Margin="{StaticResource TimerButtonGap}"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="{StaticResource BodyTextSize}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <RadioButton Style="{StaticResource ChipRadio}" GroupName="TimerPreset" Content="15"
                     Margin="{StaticResource ChipGap}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Source={StaticResource Preset15}, StringFormat={StaticResource TimerPresetNameFormat}}"
                     IsChecked="{Binding SelectedMinutes, Converter={StaticResource EqualsToBool}, ConverterParameter={StaticResource Preset15}}" />
        <RadioButton Style="{StaticResource ChipRadio}" GroupName="TimerPreset" Content="25"
                     Margin="{StaticResource ChipGap}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Source={StaticResource Preset25}, StringFormat={StaticResource TimerPresetNameFormat}}"
                     IsChecked="{Binding SelectedMinutes, Converter={StaticResource EqualsToBool}, ConverterParameter={StaticResource Preset25}}" />
        <RadioButton Style="{StaticResource ChipRadio}" GroupName="TimerPreset" Content="50"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Source={StaticResource Preset50}, StringFormat={StaticResource TimerPresetNameFormat}}"
                     IsChecked="{Binding SelectedMinutes, Converter={StaticResource EqualsToBool}, ConverterParameter={StaticResource Preset50}}" />
      </StackPanel>

      <!-- Running / paused: the remaining time, grey while paused -->
      <TextBlock Grid.Column="1"
                 Text="{Binding RemainingText}"
                 FontFamily="{StaticResource UiFont}"
                 FontSize="{StaticResource BodyTextSize}"
                 Typography.NumeralAlignment="Tabular"
                 VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource WhenNotIdle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPaused}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- The buttons on the right; the last one 12 DIP from the edge -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource TaskRowTitleMargin}">
        <!-- ▶ start (idle) -->
        <Button Style="{StaticResource IconButton}" Command="{Binding StartCommand}"
                AutomationProperties.Name="{StaticResource TimerStartName}">
          <Button.Visibility>
            <Binding Path="IsIdle" Converter="{StaticResource BoolToVisibility}" />
          </Button.Visibility>
          <TextBlock Text="{StaticResource GlyphPlay}" Style="{StaticResource IconGlyph}" />
        </Button>

        <!-- ❚❚ pause (running) -->
        <Button Style="{StaticResource IconButton}" Command="{Binding PauseCommand}"
                Margin="{StaticResource TimerButtonGap}"
                AutomationProperties.Name="{StaticResource TimerPauseName}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{StaticResource GlyphPause}" Style="{StaticResource IconGlyph}" />
        </Button>

        <!-- ▶ resume (paused) -->
        <Button Style="{StaticResource IconButton}" Command="{Binding ResumeCommand}"
                Margin="{StaticResource TimerButtonGap}"
                AutomationProperties.Name="{StaticResource TimerResumeName}"
                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{StaticResource GlyphPlay}" Style="{StaticResource IconGlyph}" />
        </Button>

        <!-- ■ stop (running or paused) -->
        <Button Command="{Binding StopCommand}"
                AutomationProperties.Name="{StaticResource TimerStopName}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsIdle}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock Text="{StaticResource GlyphStop}" Style="{StaticResource IconGlyph}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== "Replace the running session?" (PRD F4.7) ===== -->
    <StackPanel Margin="{StaticResource TimerQuestionMargin}"
                Visibility="{Binding IsAskingToReplace, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{StaticResource TimerReplaceQuestion}"
                 TextWrapping="Wrap"
                 FontFamily="{StaticResource UiFont}"
                 FontSize="{StaticResource BodyTextSize}"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource TimerQuestionButtonsMargin}">
        <Button Style="{StaticResource PrimaryChipButton}" Content="{StaticResource TimerStartNew}"
                Margin="{StaticResource TimerButtonGap}" Command="{Binding ConfirmReplaceCommand}" />
        <Button Style="{StaticResource ChipButton}" Content="{StaticResource TimerKeepCurrent}"
                Command="{Binding KeepCurrentCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
