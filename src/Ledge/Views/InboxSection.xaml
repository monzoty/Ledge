<!--
  The collapsible Inbox (DESIGN.md §2): "▸ INBOX · n" header, collapsed by
  default; when open, its rows or "Inbox is clear.". DataContext: TaskListViewModel.
  Row template and styles: Views/TaskListResources.xaml.
-->
<UserControl x:Class="Ledge.Views.InboxSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>
    <!-- The whole header line is one button that opens/closes the Inbox. -->
    <Button Style="{StaticResource BareButton}"
            Margin="{StaticResource SectionHeaderMargin}"
            Command="{Binding ToggleInboxCommand}">
      <StackPanel Orientation="Horizontal">
        <!--
          The chevron turns 90° when open. RenderTransform rotates only the
          drawing, after layout, so nothing around it moves.
          https://learn.microsoft.com/dotnet/desktop/wpf/graphics-multimedia/transforms-overview
        -->
        <TextBlock x:Name="Chevron"
                   Text="{StaticResource GlyphChevron}"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="{StaticResource ChevronIconSize}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="{StaticResource ChevronGap}"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <RotateTransform />
          </TextBlock.RenderTransform>
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsInboxExpanded}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                         To="{StaticResource ChevronExpandedAngle}"
                                         Duration="{StaticResource InboxChevronDuration}"
                                         EasingFunction="{StaticResource QuadraticEaseOut}" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                         To="0"
                                         Duration="{StaticResource InboxChevronDuration}"
                                         EasingFunction="{StaticResource QuadraticEaseOut}" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Style="{StaticResource SectionCaption}">
          <Run Text="{Binding Source={StaticResource SectionInbox}, Converter={StaticResource UpperCase}, Mode=OneWay}" /><Run Text="{StaticResource SectionCountSeparator}" /><Run Text="{Binding InboxOpenCount, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Button>

    <ItemsControl ItemsSource="{Binding Inbox}"
                  ItemTemplate="{StaticResource TaskRowTemplate}"
                  Focusable="False"
                  Visibility="{Binding IsInboxExpanded, Converter={StaticResource BoolToVisibility}}" />

    <Border Height="{StaticResource TaskRowHeight}"
            Visibility="{Binding ShowInboxEmpty, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{StaticResource InboxEmpty}" Style="{StaticResource EmptyStateText}" />
    </Border>
  </StackPanel>
</UserControl>
