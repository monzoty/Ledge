<!--
  Shared by the Today and Inbox sections: the task row template, the section
  caption style and the converters they use. Merged in App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Ledge.Converters"
                    xmlns:views="clr-namespace:Ledge.Views">

  <converters:UpperCaseConverter x:Key="UpperCase" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <!-- DESIGN.md §4: task completed, and the Inbox chevron (§2) -->
  <QuadraticEase x:Key="QuadraticEaseOut" EasingMode="EaseOut" />
  <!-- DESIGN.md §4: task deleted -->
  <QuadraticEase x:Key="QuadraticEaseIn" EasingMode="EaseIn" />

  <!-- Section caption, e.g. "TODAY · 2" (DESIGN.md §3 Caption: 12 SemiBold, TextSecondary) -->
  <Style x:Key="SectionCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionTextSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Empty-state and hint text (DESIGN.md §2): Small, TextSecondary, 12 in -->
  <Style x:Key="EmptyStateText" TargetType="TextBlock">
    <Setter Property="Margin" Value="{StaticResource EmptyStateMargin}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource SmallTextSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    A Button with no look of its own: just its content (an icon, or a whole
    header line). The transparent Border makes the full area clickable, not
    only the glyph's pixels. Never takes keyboard focus: rows have their own
    keyboard shortcuts instead (DESIGN.md §5).
  -->
  <Style x:Key="BareButton" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A hover icon in a row (move, delete): 16 DIP glyph in TextSecondary. -->
  <Style x:Key="RowIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource PanelIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    ONE row. An ItemsControl repeats this template for every TaskRowViewModel;
    inside it, {Binding Title} means that row's Title, and {Binding ToggleCommand}
    that row's command.
    https://learn.microsoft.com/dotnet/desktop/wpf/data/data-templating-overview
  -->
  <DataTemplate x:Key="TaskRowTemplate">
    <!--
      The row itself is what the keyboard selects (Focusable). Its look when
      selected comes from the triggers below, not from WPF's dotted
      FocusVisualStyle, which is switched off.
    -->
    <Border x:Name="Row"
            Height="{StaticResource TaskRowHeight}"
            CornerRadius="{StaticResource RowCornerRadius}"
            Background="Transparent"
            Focusable="True"
            FocusVisualStyle="{x:Null}">
      <!--
        Keyboard shortcuts for the selected row (DESIGN.md §5). They call the
        row's commands; while renaming those can't execute, so the keys fall
        through to the rename box (a typed space stays a space).
        https://learn.microsoft.com/dotnet/api/system.windows.input.keybinding
      -->
      <Border.InputBindings>
        <KeyBinding Key="Space" Command="{Binding ToggleCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding MoveCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartFocusCommand}" />
      </Border.InputBindings>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Checkbox -->
        <Button Grid.Column="0"
                Style="{StaticResource BareButton}"
                Margin="{StaticResource TaskRowCheckboxMargin}"
                VerticalAlignment="Center"
                Command="{Binding ToggleCommand}">
          <Grid>
            <TextBlock x:Name="OpenGlyph"
                       Text="{StaticResource GlyphCheckboxOpen}"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="{StaticResource PanelIconSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock x:Name="DoneGlyph"
                       Text="{StaticResource GlyphCheckboxDone}"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="{StaticResource PanelIconSize}"
                       Foreground="{DynamicResource SuccessBrush}"
                       Opacity="0" />
          </Grid>
        </Button>

        <!-- Title, or the rename box in its place (DESIGN.md §2 "Rename") -->
        <Grid Grid.Column="1" Margin="{StaticResource TaskRowTitleMargin}">
          <TextBlock x:Name="Title"
                     Text="{Binding Title}"
                     FontFamily="{StaticResource UiFont}"
                     FontSize="{StaticResource BodyTextSize}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center">
            <TextBlock.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding BeginRenameCommand}" />
            </TextBlock.InputBindings>
          </TextBlock>

          <Border x:Name="Editor"
                  Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="{StaticResource RowCornerRadius}"
                  Visibility="Collapsed">
            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                     views:RenameBox.IsEditing="{Binding IsEditing}"
                     views:RenameBox.CommitOnBlur="{Binding CommitRenameCommand}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     FontFamily="{StaticResource UiFont}"
                     FontSize="{StaticResource BodyTextSize}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     VerticalContentAlignment="Center">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </Border>
        </Grid>

        <!--
          Hover icons (DESIGN.md §2): delete, then move at the right edge. Hidden
          (not just transparent) so they can't be clicked while invisible; Hidden
          still reserves their space, so titles don't re-flow when they appear.
        -->
        <Button x:Name="DeleteButton"
                Grid.Column="2"
                Style="{StaticResource BareButton}"
                Margin="{StaticResource TaskRowDeleteMargin}"
                VerticalAlignment="Center"
                Visibility="Hidden"
                ToolTip="{StaticResource DeleteTask}"
                Command="{Binding DeleteCommand}">
          <TextBlock x:Name="DeleteGlyph" Text="{StaticResource GlyphDelete}" Style="{StaticResource RowIcon}" />
        </Button>

        <Button x:Name="MoveButton"
                Grid.Column="3"
                Style="{StaticResource BareButton}"
                Margin="{StaticResource TaskRowActionMargin}"
                VerticalAlignment="Center"
                Visibility="Hidden"
                ToolTip="{StaticResource MoveToInbox}"
                Command="{Binding MoveCommand}">
          <TextBlock x:Name="MoveGlyph" Text="{StaticResource GlyphMoveToInbox}" Style="{StaticResource RowIcon}" />
        </Button>

        <!--
          Linked to the focus timer (DESIGN.md §2 "Linked task marker"): an amber
          stopwatch in the move icon's spot, 12 DIP from the edge. Shown by the
          IsLinkedToTimer trigger below and hidden again while hovered.
        -->
        <TextBlock x:Name="LinkedMark"
                   Grid.Column="3"
                   Margin="{StaticResource TaskRowActionMargin}"
                   Text="{StaticResource GlyphStopwatch}"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="{StaticResource PanelIconSize}"
                   Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   AutomationProperties.Name="{StaticResource TimerLinkedName}" />

        <!--
          Keyboard focus ring (DESIGN.md §3): drawn ON TOP of the row as an
          overlay, so turning it on doesn't shift the content by 2 DIP.
        -->
        <Border x:Name="FocusRing"
                Grid.ColumnSpan="4"
                CornerRadius="{StaticResource RowCornerRadius}"
                BorderThickness="{StaticResource FocusRingThickness}"
                BorderBrush="Transparent"
                IsHitTestVisible="False" />
      </Grid>
    </Border>

    <DataTemplate.Triggers>
      <!--
        Order matters: when several triggers set the same property, the LATER
        one wins. So "linked" shows the marker, and "hovered" (below it) hides
        it again to make room for the icons.
      -->
      <DataTrigger Binding="{Binding IsLinkedToTimer}" Value="True">
        <Setter TargetName="LinkedMark" Property="Visibility" Value="Visible" />
      </DataTrigger>

      <!-- Hover: Surface background (DESIGN.md §3) and the two icons. -->
      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
        <Setter TargetName="MoveButton" Property="Visibility" Value="Visible" />
        <Setter TargetName="LinkedMark" Property="Visibility" Value="Collapsed" />
      </Trigger>

      <!-- The trash turns Danger while the mouse is on it (DESIGN.md §2). -->
      <Trigger SourceName="DeleteButton" Property="IsMouseOver" Value="True">
        <Setter TargetName="DeleteGlyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
      </Trigger>

      <!--
        Selected with the keyboard: ring + Surface (DESIGN.md §2). Rows only ever
        get focus from the keyboard code, so this never shows after a mouse click.
      -->
      <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      </Trigger>

      <!-- Inbox rows offer the opposite move. -->
      <DataTrigger Binding="{Binding IsInInbox}" Value="True">
        <Setter TargetName="MoveGlyph" Property="Text" Value="{StaticResource GlyphMoveToToday}" />
        <Setter TargetName="MoveButton" Property="ToolTip" Value="{StaticResource MoveToToday}" />
      </DataTrigger>

      <!-- Renaming: the box replaces the title. -->
      <DataTrigger Binding="{Binding IsEditing}" Value="True">
        <Setter TargetName="Title" Property="Visibility" Value="Hidden" />
        <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
      </DataTrigger>

      <!--
        Done (DESIGN.md §4): the check fills, strikethrough appears, the row
        drops to 60 % — over 150 ms. EnterActions run when IsDone becomes true,
        ExitActions when it goes back to false. No "From" values, so a quick
        double-click reverses smoothly from wherever it is.
        https://learn.microsoft.com/dotnet/api/system.windows.triggerbase.enteractions
      -->
      <DataTrigger Binding="{Binding IsDone}" Value="True">
        <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity"
                               To="{StaticResource TaskDoneOpacity}" Duration="{StaticResource TaskDoneDuration}"
                               EasingFunction="{StaticResource QuadraticEaseOut}" />
              <DoubleAnimation Storyboard.TargetName="DoneGlyph" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource TaskDoneDuration}"
                               EasingFunction="{StaticResource QuadraticEaseOut}" />
              <DoubleAnimation Storyboard.TargetName="OpenGlyph" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="{StaticResource TaskDoneDuration}"
                               EasingFunction="{StaticResource QuadraticEaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource TaskDoneDuration}"
                               EasingFunction="{StaticResource QuadraticEaseOut}" />
              <DoubleAnimation Storyboard.TargetName="DoneGlyph" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="{StaticResource TaskDoneDuration}"
                               EasingFunction="{StaticResource QuadraticEaseOut}" />
              <DoubleAnimation Storyboard.TargetName="OpenGlyph" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource TaskDoneDuration}"
                               EasingFunction="{StaticResource QuadraticEaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>

      <!--
        Delete (DESIGN.md §4): height and opacity go to 0 in 120 ms. The
        ViewModel waits the same time (TaskListMotion), then removes the task.
      -->
      <DataTrigger Binding="{Binding IsRemoving}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Height"
                               To="0" Duration="{StaticResource TaskRemoveDuration}"
                               EasingFunction="{StaticResource QuadraticEaseIn}" />
              <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="{StaticResource TaskRemoveDuration}"
                               EasingFunction="{StaticResource QuadraticEaseIn}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
