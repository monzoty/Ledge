<!--
  The Today section (DESIGN.md §2): "TODAY · n" header, one row per task,
  or the empty-state text. DataContext: TaskListViewModel.
-->
<UserControl x:Class="Ledge.Views.TodaySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Ledge.Converters">

  <UserControl.Resources>
    <converters:UpperCaseConverter x:Key="UpperCase" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <QuadraticEase x:Key="DoneEasing" EasingMode="EaseOut" />

    <!--
      The checkbox: a Button whose whole look is replaced by two stacked glyphs.
      Open shows the outline; done cross-fades to the filled check (DESIGN.md §2).
      Not keyboard-focusable yet: keyboard control of rows arrives in step 3c.
    -->
    <Style x:Key="CheckboxButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      ONE row. The ItemsControl below repeats this template for every
      TaskRowViewModel in Today; inside it, {Binding Title} means that row's Title.
      https://learn.microsoft.com/dotnet/desktop/wpf/data/data-templating-overview
    -->
    <DataTemplate x:Key="TaskRowTemplate">
      <Border x:Name="Row"
              Height="{StaticResource TaskRowHeight}"
              CornerRadius="{StaticResource RowCornerRadius}"
              Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!--
            The command lives on the LIST's ViewModel, not the row's, so the
            binding climbs up to the ItemsControl and uses its DataContext.
            CommandParameter="{Binding}" passes this row's ViewModel.
          -->
          <Button Grid.Column="0"
                  Style="{StaticResource CheckboxButton}"
                  Margin="{StaticResource TaskRowCheckboxMargin}"
                  VerticalAlignment="Center"
                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}">
            <Grid>
              <TextBlock x:Name="OpenGlyph"
                         Text="{StaticResource GlyphCheckboxOpen}"
                         FontFamily="{StaticResource IconFont}"
                         FontSize="{StaticResource PanelIconSize}"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock x:Name="DoneGlyph"
                         Text="{StaticResource GlyphCheckboxDone}"
                         FontFamily="{StaticResource IconFont}"
                         FontSize="{StaticResource PanelIconSize}"
                         Foreground="{StaticResource SuccessBrush}"
                         Opacity="0" />
            </Grid>
          </Button>

          <TextBlock x:Name="Title"
                     Grid.Column="1"
                     Text="{Binding Title}"
                     Margin="{StaticResource TaskRowTitleMargin}"
                     FontFamily="{StaticResource UiFont}"
                     FontSize="{StaticResource BodyTextSize}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <!-- Rows use Surface on hover (DESIGN.md §3). -->
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Trigger>

        <!--
          Done (DESIGN.md §4): the check fills, strikethrough appears, the row
          drops to 60 % — over 150 ms. EnterActions run when IsDone becomes true,
          ExitActions when it goes back to false. No "From" values, so a quick
          double-click reverses smoothly from wherever it is.
          https://learn.microsoft.com/dotnet/api/system.windows.triggerbase.enteractions
        -->
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity"
                                 To="{StaticResource TaskDoneOpacity}" Duration="{StaticResource TaskDoneDuration}"
                                 EasingFunction="{StaticResource DoneEasing}" />
                <DoubleAnimation Storyboard.TargetName="DoneGlyph" Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="{StaticResource TaskDoneDuration}"
                                 EasingFunction="{StaticResource DoneEasing}" />
                <DoubleAnimation Storyboard.TargetName="OpenGlyph" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="{StaticResource TaskDoneDuration}"
                                 EasingFunction="{StaticResource DoneEasing}" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="{StaticResource TaskDoneDuration}"
                                 EasingFunction="{StaticResource DoneEasing}" />
                <DoubleAnimation Storyboard.TargetName="DoneGlyph" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="{StaticResource TaskDoneDuration}"
                                 EasingFunction="{StaticResource DoneEasing}" />
                <DoubleAnimation Storyboard.TargetName="OpenGlyph" Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="{StaticResource TaskDoneDuration}"
                                 EasingFunction="{StaticResource DoneEasing}" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <!-- "TODAY · 2": Caption style (DESIGN.md §3), counts open tasks (§2). -->
    <TextBlock Margin="{StaticResource SectionHeaderMargin}"
               FontFamily="{StaticResource UiFont}"
               FontSize="{StaticResource CaptionTextSize}"
               FontWeight="SemiBold"
               Foreground="{StaticResource TextSecondaryBrush}">
      <Run Text="{Binding Source={StaticResource SectionToday}, Converter={StaticResource UpperCase}, Mode=OneWay}" /><Run Text="{StaticResource SectionCountSeparator}" /><Run Text="{Binding TodayOpenCount, Mode=OneWay}" />
    </TextBlock>

    <ItemsControl ItemsSource="{Binding Today}"
                  ItemTemplate="{StaticResource TaskRowTemplate}"
                  Focusable="False" />

    <!-- Empty state (DESIGN.md §2, §6): Small, secondary, one row high. -->
    <Border Height="{StaticResource TaskRowHeight}"
            Visibility="{Binding IsTodayEmpty, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{StaticResource TodayEmpty}"
                 Margin="{StaticResource EmptyStateMargin}"
                 FontFamily="{StaticResource UiFont}"
                 FontSize="{StaticResource SmallTextSize}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 VerticalAlignment="Center" />
    </Border>
  </StackPanel>
</UserControl>
