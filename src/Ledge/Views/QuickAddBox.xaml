<!--
  Quick-add box (DESIGN.md §2): "[+] Add a task…  ⏎".
  DataContext: TaskListViewModel (set by PillWindow).
-->
<UserControl x:Class="Ledge.Views.QuickAddBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="{StaticResource QuickAddHeight}">

  <Border CornerRadius="{StaticResource RowCornerRadius}"
          Background="{StaticResource SurfaceBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{StaticResource GlyphAdd}"
                 Margin="{StaticResource QuickAddLeadingIconMargin}"
                 FontFamily="{StaticResource IconFont}"
                 FontSize="{StaticResource PanelIconSize}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 VerticalAlignment="Center" />

      <!-- Placeholder: shown only while the box is empty -->
      <TextBlock Grid.Column="1"
                 Text="{StaticResource QuickAddPlaceholder}"
                 FontFamily="{StaticResource UiFont}"
                 FontSize="{StaticResource BodyTextSize}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!--
        Two-way binding to QuickAddText. UpdateSourceTrigger=PropertyChanged
        copies every keystroke to the ViewModel at once (the default waits until
        the box loses focus, so Enter would add the OLD text).
        https://learn.microsoft.com/dotnet/desktop/wpf/data/how-to-control-when-the-textbox-text-updates-the-source
      -->
      <TextBox x:Name="Input"
               Grid.Column="1"
               Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               FontFamily="{StaticResource UiFont}"
               FontSize="{StaticResource BodyTextSize}"
               Foreground="{StaticResource TextPrimaryBrush}"
               CaretBrush="{StaticResource TextPrimaryBrush}"
               VerticalContentAlignment="Center">
        <!-- Enter runs AddCommand (generated from Add() by [RelayCommand]). -->
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <TextBlock Grid.Column="2"
                 Text="{StaticResource GlyphReturnKey}"
                 Margin="{StaticResource QuickAddTrailingIconMargin}"
                 FontFamily="{StaticResource IconFont}"
                 FontSize="{StaticResource PanelIconSize}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
